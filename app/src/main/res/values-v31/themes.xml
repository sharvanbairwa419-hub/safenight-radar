<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen: instant dark launch, no login wall. -->
    <style name="Theme.SafeNight" parent="Theme.SafeNight.Base">
        <item name="android:windowSplashScreenBackground">@color/night_void</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/night_void</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
