<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Privacy first: no sensor or location history is ever backed up. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
